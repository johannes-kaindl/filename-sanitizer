{
  "sources": {
    "obsidian-kit": {
      "ref": "0.82.0"
    },
    "code-kit": {
      "ref": "0.63.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "filename-policy",
        "ignore",
        "rotation",
        "settings",
        "i18n",
        "repeat-guard",
        "word-diff"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "vault-path"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "filename-sanitizer-source"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "./"
        ]
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "hub",
        "review-list",
        "redline",
        "help-setting",
        "collapsible",
        "confirm",
        "plugin-api",
        "safe-file-name",
        "settings_walker",
        "folder-suggest"
      ],
      "rewrite": [
        [
          "../pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock"
      ]
    }
  ]
}
